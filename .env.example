# ── Supabase ─────────────────────────────────────────────
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...     # web (navegador) — respeta RLS
SUPABASE_SECRET_KEY=sb_secret_...               # SOLO servidores de voz/WhatsApp. Nunca en el navegador.
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres   # solo para db:push

# ── Gemini (Google AI Studio) ────────────────────────────
GEMINI_API_KEY=
# Endpoint compatible con OpenAI para texto (supervisor / WhatsApp):
GEMINI_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ── Agente ───────────────────────────────────────────────
PORT=3000
AGENT_SHARED_SECRET=             # la misma en web-banco/apps/dashboard/.env.local
PUBLIC_WEB_URL=http://localhost:3001
SIMULATE_CALLS=true              # sin ElevenLabs, simula las llamadas con Gemini
TEST_CUSTOMER_CODE=DEMO-001      # cliente para "Probar agente" desde el panel de ElevenLabs

# ── Voz: ElevenLabs Agents (+ número de Twilio importado) ─
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=
CUSTOM_LLM_SECRET=               # ElevenLabs lo envía como Authorization: Bearer … al Custom LLM

# ── Correo ───────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Bancoagrícola Demo <onboarding@resend.dev>

# ── WhatsApp ─────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── App ──────────────────────────────────────────────────
PAYMENT_LINK_BASE_URL=http://localhost:3000/pagar/
TZ=America/El_Salvador
